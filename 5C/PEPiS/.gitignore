# Merged from lab1-gpio/.gitignore, lab2/.gitignore, lab3/.gitignore, lab4/.gitignore.
# NOTE: .ruff_cache/.gitignore is managed by ruff and intentionally left in place.
# Patterns without a slash match at every level, so .pio / .DS_Store / *.lck /
# *.kicad_prl behave exactly as before. The .vscode paths were relative to each
# lab dir and are spelled with **/ to keep matching labX/.vscode/.

.pio
**/.vscode/.browse.c_cpp.db*
**/.vscode/c_cpp_properties.json
**/.vscode/launch.json
**/.vscode/ipch
.DS_Store
__pycache__/
*.lck
*.kicad_prl
.history/
