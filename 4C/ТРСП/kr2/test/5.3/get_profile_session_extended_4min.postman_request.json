{
  "name": "get_profile_session_extended_4min",
  "request": {
    "method": "GET",
    "header": [],
    "url": {
      "raw": "{{base_url}}/user",
      "host": ["{{base_url}}"],
      "path": ["user"]
    },
    "description": "Задание 5.3: Запрос через 4 минуты — сессия продлевается (3-5 мин)"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "exec": [
          "pm.test('Status code is 200', function() {",
          "    pm.response.to.have.status(200);",
          "});",
          "pm.test('Session is extended', function() {",
          "    var jsonData = pm.response.json();",
          "    pm.expect(jsonData.is_authenticated).to.be.true;",
          "});"
        ],
        "type": "text/javascript"
      }
    }
  ],
  "protocolProfileBehavior": {
    "disableCookies": false
  }
}