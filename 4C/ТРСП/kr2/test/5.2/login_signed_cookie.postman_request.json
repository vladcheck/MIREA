{
  "name": "login_signed_cookie",
  "request": {
    "method": "POST",
    "header": [
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "body": {
      "mode": "raw",
      "raw": "{\n  \"username\": \"user123\",\n  \"password\": \"password123\"\n}"
    },
    "url": {
      "raw": "{{base_url}}/login",
      "host": ["{{base_url}}"],
      "path": ["login"]
    },
    "description": "Задание 5.2: Вход с подписанным cookie (itsdangerous)"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "exec": [
          "pm.test('Status code is 200', function() {",
          "    pm.response.to.have.status(200);",
          "});",
          "pm.test('Session token is signed (contains dots)', function() {",
          "    var jsonData = pm.response.json();",
          "    pm.expect(jsonData.session_token).to.include('.');",
          "});",
          "pm.test('Cookie has httponly flag', function() {",
          "    var cookieHeader = pm.response.headers.get('Set-Cookie');",
          "    pm.expect(cookieHeader).to.include('HttpOnly');",
          "});"
        ],
        "type": "text/javascript"
      }
    }
  ]
}