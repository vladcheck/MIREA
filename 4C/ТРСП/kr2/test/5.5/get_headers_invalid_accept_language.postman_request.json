{
  "name": "get_headers_common_model",
  "request": {
    "method": "GET",
    "header": [
      {
        "key": "User-Agent",
        "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)"
      },
      {
        "key": "Accept-Language",
        "value": "en-US,en;q=0.9,es;q=0.8"
      }
    ],
    "url": {
      "raw": "{{base_url}}/headers",
      "host": ["{{base_url}}"],
      "path": ["headers"]
    },
    "description": "Задание 5.5: Использование CommonHeaders модели для /headers"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "exec": [
          "pm.test('Status code is 200', function() {",
          "    pm.response.to.have.status(200);",
          "});",
          "pm.test('Response contains headers object', function() {",
          "    var jsonData = pm.response.json();",
          "    pm.expect(jsonData.user_agent).to.exist;",
          "    pm.expect(jsonData.accept_language).to.exist;",
          "});"
        ],
        "type": "text/javascript"
      }
    }
  ]
}