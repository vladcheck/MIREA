{
  "name": "login_invalid_credentials",
  "request": {
    "method": "POST",
    "header": [
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "body": {
      "mode": "raw",
      "raw": "{\n  \"username\": \"user123\",\n  \"password\": \"wrongpassword\"\n}"
    },
    "url": {
      "raw": "{{base_url}}/login",
      "host": ["{{base_url}}"],
      "path": ["login"]
    },
    "description": "Задание 5.1: Ошибка входа — неверные учётные данные"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "exec": [
          "pm.test('Status code is 401', function() {",
          "    pm.response.to.have.status(401);",
          "});",
          "pm.test('Response contains error message', function() {",
          "    var jsonData = pm.response.json();",
          "    pm.expect(jsonData.detail).to.exist;",
          "});"
        ],
        "type": "text/javascript"
      }
    }
  ]
}