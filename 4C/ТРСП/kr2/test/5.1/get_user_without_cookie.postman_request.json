{
  "name": "get_user_without_cookie",
  "request": {
    "method": "GET",
    "header": [],
    "url": {
      "raw": "{{base_url}}/user",
      "host": ["{{base_url}}"],
      "path": ["user"]
    },
    "description": "Задание 5.1: Получение профиля без cookie — ошибка 401 Unauthorized"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "exec": [
          "pm.test('Status code is 401', function() {",
          "    pm.response.to.have.status(401);",
          "});",
          "pm.test('Response contains Unauthorized message', function() {",
          "    var jsonData = pm.response.json();",
          "    pm.expect(jsonData.detail.message || jsonData.message).to.include('Unauthorized');",
          "});"
        ],
        "type": "text/javascript"
      }
    }
  ],
  "protocolProfileBehavior": {
    "disableCookies": true
  }
}