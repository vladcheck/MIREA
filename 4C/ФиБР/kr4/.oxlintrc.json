{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "oxc",
    "node"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
    "style": "warn"
  },
  "rules": {
    "func-style": "allow",
    "id-length": "allow",
    "no-async-endpoint-handlers": "error"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "node_modules"
  ]
}