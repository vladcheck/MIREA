# Учётная запись РТУ МИРЭА (единый SSO, почта вида login@edu.mirea.ru)
MIREA_LOGIN=
MIREA_PASSWORD=
# Почта для Email OTP
EMAIL=

# Опционально: собственный wstoken СДО. DORMANT: REST на online-edu отключён,
# рабочий вход — OIDC-заезд по сессии Пульса (mirea_auth_start → mirea_auth_otp);
# переменная — только ручной wstoken, если вуз когда-нибудь включит REST.
# MIREA_SDO_TOKEN=

# Опционально: каталог состояния (сессии, токены). По умолчанию .state/
# внутри пакета; каталог и .env игнорируются git.
# MIREA_STATE_DIR=
