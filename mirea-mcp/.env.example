# Учётная запись РТУ МИРЭА (единый SSO, почта вида login@edu.mirea.ru)
MIREA_LOGIN=
MIREA_PASSWORD=
# Почта для Email OTP
EMAIL=

# Опционально: собственный wstoken СДО.
# Если login/token.php отключён — создаётся вручную в профиле Moodle
# (Настройки профиля -> Ключи безопасности).
# MIREA_SDO_TOKEN=

# Опционально: каталог состояния (сессии, токены). По умолчанию .state/
# внутри пакета; каталог и .env игнорируются git.
# MIREA_STATE_DIR=
